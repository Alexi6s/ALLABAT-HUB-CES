{
  "name": "alabatt-ces",
  "private": true,
  "description": "ALABATT-CES: entrepreneurship management and support platform (ALABATT-HUB). Zero runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node apps/api/src/server.ts",
    "dev": "node --watch apps/api/src/server.ts",
    "test": "node --test --test-concurrency=1 \"apps/api/test/*.test.ts\"",
    "typecheck": "tsc -p apps/api/tsconfig.json",
    "check:web": "node scripts/check-web.mjs",
    "test:e2e": "node tests/e2e/ui.e2e.mjs",
    "seed:demo": "node apps/api/src/seed-demo.ts",
    "docs:api": "node scripts/gen-api-docs.ts",
    "backup": "node scripts/backup.ts",
    "docs:db": "node scripts/gen-db-docs.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  }
}
