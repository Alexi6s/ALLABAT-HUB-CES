# Copy to .env and edit. Never commit .env. The server reads real environment variables;
# load this file with your process manager or `node --env-file=.env apps/api/src/server.ts`.

NODE_ENV=production
PORT=8787
# Public address of the app (used in email links).
APP_URL=https://ces.example.org

# Where the SQLite database and private uploads live. Must be a persistent, backed-up volume.
DATA_DIR=/var/lib/alabatt-ces
# DB_FILE=/var/lib/alabatt-ces/alabatt-ces.sqlite

SESSION_HOURS=12
MAX_UPLOAD_BYTES=5242880

# Number of distinct reviewer approvals required before a mentor is approved (can also be changed by a super admin in the app).
MENTOR_APPROVALS_REQUIRED=1

# First super administrator. Both must be set; the account is created only if that email does not exist yet.
# Use a strong password, sign in, then remove these two lines.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Development only: expose email-confirmation and reset tokens in API responses so flows work without an email provider.
# Ignored (always off) when NODE_ENV=production.
# EXPOSE_DEV_TOKENS=true

# Outbound email. NOTE: the settings below are read by the app, but this build does not contain a sender yet,
# so nothing is emailed whether or not they are filled in. See docs/OPERATIONS.md ("Email").
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false            # true = TLS from the first byte (usually port 465)
# SMTP_STARTTLS=true           # upgrade a plain connection when the server offers it
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ALABATT-CES <no-reply@ces.example.org>
# SMTP_TLS_REJECT_UNAUTHORIZED=true
